# Variáveis de Ambiente - AgendaFácil API
# Copie este arquivo para .env e preencha os valores

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=agendafacil

# JWT (OBRIGATÓRIO - gere uma chave forte com: openssl rand -hex 32)
JWT_SECRET=

# Google OAuth (obtenha em https://console.cloud.google.com)
GOOGLE_CLIENT_ID=

# Servidor
PORT=3001
NODE_ENV=development

# Front-End URL (para CORS)
FRONTEND_URL=http://localhost:5173
